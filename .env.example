# ─────────────────────────────────────────────────────────────────────────────
# The Dispatch — environment variables
# Copy to .env for local runs. In GitHub Actions these come from repo Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Shared — all three feeds
GEMINI_API_KEY=

# Email delivery (only the AI feed sends by default; see SEND_EMAIL below)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# PMM feed only — job scraping + community signals
APIFY_API_KEY=
CRUNCHBASE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pmm_digest_bot/1.0
# GITHUB_TOKEN is provided automatically in Actions; set one locally if needed

# ─────────────────────────────────────────────────────────────────────────────
# Email on/off per run. Default: AI = on, Brief = off, PMM = off.
# Set SEND_EMAIL=true or false to override for a given run.
# ─────────────────────────────────────────────────────────────────────────────
# SEND_EMAIL=
